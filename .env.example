# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Frontend Monitoring Endpoint Variables
# Supported VITE_APP_ENV values: local, lan, remote
VITE_APP_ENV="local"
VITE_MONITOR_API_URL="http://127.0.0.1:8090"
VITE_MONITOR_WS_URL="ws://127.0.0.1:8090/ws/live"
# Set to "true" to run in standalone mock mode (required for AI Studio preview without local MediaMTX server)
VITE_USE_MOCK_DATA="true"

# Development telemetry debug flag (Set to "true" to enable diagnostic lifecycle logs and heartbeat badge)
VITE_TELEMETRY_DEBUG="true"

# Backend MediaMTX Internal Service URLs (Connected privately by server.ts, never exposed to browser)
MEDIAMTX_CONTROL_API="http://127.0.0.1:9997"
MEDIAMTX_METRICS_URL="http://127.0.0.1:9998/metrics"

# Optional Playback URL Base Overrides (If omitted, derived dynamically from request Host header)
# PUBLIC_WEBRTC_BASE_URL="http://192.168.1.30:8889"
# PUBLIC_HLS_BASE_URL="http://192.168.1.30:8888"
# Memory Pressure Monitoring & Early Warning Configurations
MEMORY_SAMPLE_INTERVAL_MS=10000
MEMORY_HISTORY_MAX_SAMPLES=360
MEMORY_WATCH_AVAILABLE_PERCENT=30
MEMORY_WARNING_AVAILABLE_PERCENT=20
MEMORY_CRITICAL_AVAILABLE_PERCENT=10
MEMORY_EMERGENCY_AVAILABLE_PERCENT=5
MEMORY_WARNING_PROJECTED_MINUTES=30
MEMORY_CRITICAL_PROJECTED_MINUTES=10
MEMORY_MIN_DECLINE_RATE_MB_PER_MIN=100
MEMORY_ALERT_REMINDER_MINUTES=15

# Extended Browser Memory Protection & Diagnostic Configs
MEMORY_BROWSER_HEAP_WARNING_PERCENT=80
MEMORY_BROWSER_HEAP_CRITICAL_PERCENT=90
MEMORY_BROWSER_HEAP_GROWTH_MB_PER_MIN=50
MEMORY_JS_HEAP_SAMPLE_INTERVAL_MS=10000
MEMORY_BROWSER_HEAP_HISTORY_MAX_SAMPLES=720
MEMORY_DIAGNOSTIC_EXPORT_MAX_EVENTS=200
MEMORY_RESOURCE_SAMPLE_INTERVAL_MS=30000
MEMORY_RESOURCE_HISTORY_MAX_SAMPLES=360
MEMORY_ENABLE_BROWSER_HEAP_MONITOR=true
MEMORY_ENABLE_RESOURCE_MONITOR=true
MEMORY_ENABLE_HEALTH_PREDICTION=true
MEMORY_ENABLE_LEAK_SUSPICION=true
MEMORY_ENABLE_DEBUG_OVERLAY=false


